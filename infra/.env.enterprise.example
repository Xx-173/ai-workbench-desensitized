POSTGRES_DB=craft_workbench
POSTGRES_USER=craft
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_PORT=5432
REDIS_PORT=6379
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=workbench
S3_ACCESS_KEY=workbench-dev
S3_SECRET_KEY=replace-with-a-long-random-password
S3_FORCE_PATH_STYLE=true

# Craft server / Agent Workbench
CRAFT_TEAM_MODE=true
CRAFT_SERVER_TOKEN=replace-with-a-random-session-secret
CRAFT_TEAM_ADMIN_USERNAME=admin
CRAFT_TEAM_ADMIN_PASSWORD=replace-with-a-strong-admin-password
AGENT_WORKBENCH_MASTER_KEY=replace-with-base64-encoded-32-byte-key
AGENT_WORKBENCH_ROOT=/var/lib/craft-agent/agent-workbench
AGENT_WORKBENCH_DATABASE_URL=postgresql://craft:replace-with-a-long-random-password@postgres:5432/craft_workbench
AGENT_WORKBENCH_DATABASE_SSL=false
AGENT_WORKBENCH_REDIS_URL=redis://redis:6379
# Set true after the Redis worker has been enabled for long-running Agents.
AGENT_WORKBENCH_ASYNC_TASKS=false
AGENT_WORKBENCH_START_WORKER=false
AGENT_WORKBENCH_QUEUE_STREAM=craft-workbench:tasks
AGENT_WORKBENCH_QUEUE_GROUP=craft-workbench-workers
